{
	"name": "firefox-css-theme",
	"version": "0.2.2",
	"description": "CLI toolkit and Model Context Protocol server for building, inspecting, and live-debugging Firefox UI and CSS themes.",
	"homepage": "https://github.com/easonwong-de/Firefox-CSS-Theme#readme",
	"bugs": {
		"url": "https://github.com/easonwong-de/Firefox-CSS-Theme/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/easonwong-de/Firefox-CSS-Theme.git"
	},
	"license": "MIT",
	"author": "Eason Wong <me@easonwong.de> (https://easonwong.de/)",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"firefox-css-theme": "dist/cli.js",
		"firefox-css-theme-mcp": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"format": "prettier --write --list-different .",
		"prepublishOnly": "npm run build",
		"start": "node dist/cli.js start",
		"test": "tsx tests/run.ts --headless"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"chokidar": "^5.0.0",
		"commander": "^15.0.0",
		"postcss": "^8.5.3",
		"postcss-import": "^17.0.0",
		"selenium-webdriver": "^4.48.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@types/postcss-import": "^14.0.3",
		"@types/selenium-webdriver": "^4.35.6",
		"prettier": "^3.9.6",
		"prettier-plugin-jsdoc": "^1.8.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	}
}
